rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function gestao() {
      return request.auth != null && sessaoValida() && perfil().get('ativo',true) == true && perfil().papel in ['master', 'admin', 'nutricionista', 'gerente'];
    }
    function sessaoValida() {
      return request.auth.token.get('auth_time',0) * 1000 > request.time.toMillis() - 28800000 &&
        request.auth.token.get('auth_time',0) >= perfil().get('sessaoRevogadaEm',0);
    }
    function acesso(escolaId) {
      return request.auth != null && sessaoValida() && perfil().get('ativo',true) == true &&
        (gestao() || (perfil().papel == 'diretor' && escolaId in perfil().escolasVinculadas));
    }
    match /assinaturas/{escolaId}/{uid}/{arquivo} {
      allow read: if acesso(escolaId);
      // Apenas leitura de arquivos legados; novos registros usam CPF e download local.
      allow create, update, delete: if false;
    }
    match /backups/{tipo}/{arquivo} {
      allow read: if gestao();
      allow create, update, delete: if false;
    }
  }
}
